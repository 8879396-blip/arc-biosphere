# ---- server ----
PORT=4030
PP_BIO_NAME=Arc Biosphere
PP_FOUNDERS=24
PP_DATA_DIR=.data-bio
PP_BIO_FILE=.data-bio/biosphere.json
PP_WEB_DIR=web
# 自动推进：不设则只有客户付费才推进 tick
PP_AUTOTICK_MS=1500
PP_AUTOTICK_TICKS=1

# ---- x402 ----
# mock = 本地演练，不动真钱（此时所有外部收入一律记为补贴，绝不冒充真实收入）
# gateway = 走真实 facilitator
PP_FACILITATOR=mock
PP_NETWORK=arcTestnet
# PP_SELLER_KEY=0x...        # 收款钱包私钥（gateway 模式）

# ---- 公网地址（OG / 分享卡片用；部署后必填，例如 https://biosphere.example）----
# PP_PUBLIC_URL=https://biosphere.example

# ---- on-chain commitment ----
# PP_REGISTRY=0x<BiosphereRegistry 地址>
# PP_SUBSIDY_POOL=0x<SubsidyPool 地址>
PP_CHAIN_NET=mainnet
# 运营方钱包：这些地址付的钱算补贴，不算真实收入（逗号分隔）
# PP_SUBSIDY_WALLETS=0x...

# ---- deployer (tools/deploy-contracts.js, tools/commit-state.js) ----
# 只放 operator 钱包（gas 用途，$5-10 足够）；creator 多签私钥永远不要放服务器
# ARC_PK=0x<64 hex>
